# ─────────────────────────────────────────────────────────────────────────────
# Stella Force — environment variables
# Copy this file to `.env.local` and fill in real values. Never commit secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — used by the browser client. RLS enforces access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key — SERVER ONLY. Bypasses RLS. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (Claude) API key — SERVER ONLY. Used for AI parsing + embeddings.
ANTHROPIC_API_KEY=sk-ant-your-key

# n8n webhook that parses an uploaded resume — SERVER ONLY.
N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/parse-resume

# Shared secret sent as `Authorization: Bearer <secret>` to the webhook above — SERVER ONLY.
N8N_WEBHOOK_SECRET=your-n8n-webhook-secret

# n8n webhook that emails the "connect your Google Calendar" invite — SERVER ONLY.
N8N_CALENDAR_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/calendar-connect-invite

# n8n webhook that places an outbound test call for a screening agent — SERVER ONLY.
N8N_VOICE_TEST_CALL_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/voice-test-call

# Signing secret for verifying ElevenLabs post-call webhook payloads — SERVER ONLY.
ELEVENLABS_POSTCALL_WEBHOOK_SECRET=wsec_your-elevenlabs-webhook-secret

# Google Cloud OAuth 2.0 Web Client (Calendar API enabled, scope calendar.events,
# redirect URI ${SITE_URL}/api/calendar/oauth/callback) — SERVER ONLY.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# AES-256-GCM key (base64, 32 bytes) for encrypting stored Google refresh
# tokens — SERVER ONLY. Generate with: openssl rand -base64 32
CALENDAR_TOKEN_ENCRYPTION_KEY=your-32-byte-base64-key

# HMAC key for signing the OAuth `state` param — SERVER ONLY, keep separate
# from CALENDAR_TOKEN_ENCRYPTION_KEY. Generate with: openssl rand -base64 32
CALENDAR_STATE_SECRET=your-hmac-signing-key

# Absolute site origin (no trailing slash) — used to build the OAuth redirect_uri
# and links embedded in outbound emails.
SITE_URL=https://your-app.example.com
